# Optional. Without a key, MemePop uses the deterministic local generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_JUDGE_MODEL=gpt-5.6

# Required only when calling the protected candidate-pool replenishment endpoint.
MEMEPOP_ADMIN_SECRET=

# 微信小程序登录。申请 AppID 后在服务端配置，AppSecret 不得写入 miniapp。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
