# 本地开发：微信开发者工具需临时关闭合法域名校验。
TARO_APP_API_BASE_URL=http://localhost:3000
TARO_APP_AUTH_MODE=mock

# 获得真实 AppID 后，可在本机的 .env.development.local 中覆盖：
# TARO_APP_ID=wx0000000000000000
# TARO_APP_AUTH_MODE=wechat

# 正式构建请在 .env.production.local 中配置备案 HTTPS 域名：
# TARO_APP_API_BASE_URL=https://api.example.com
