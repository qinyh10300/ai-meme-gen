{
  "name": "ai-meme-gen",
  "version": "0.1.0",
  "description": "MemePop: AI-powered Chinese internet meme workflow",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "meme": "tsx src/cli.ts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "mini:dev": "npm --prefix miniapp run dev:weapp",
    "mini:build": "npm --prefix miniapp run build:weapp",
    "mini:typecheck": "npm --prefix miniapp run typecheck",
    "mini:test": "npm --prefix miniapp test",
    "db:generate": "drizzle-kit generate",
    "eval:humor": "tsx src/scripts/evaluate-humor.ts",
    "jokes:audit": "tsx src/scripts/audit-jokes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "openai": "^7.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.21.3"
  }
}
